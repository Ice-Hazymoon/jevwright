{
    "name": "@hazymoon/jevwright",
    "type": "module",
    "version": "0.4.0",
    "description": "Natural-language browser tests for business flows: TypeSafe's Jev grounds each step on the live page, and your code decides pass or fail.",
    "author": "Ice-Hazymoon",
    "license": "MIT",
    "homepage": "https://github.com/Ice-Hazymoon/jevwright#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ice-Hazymoon/jevwright.git"
    },
    "bugs": {
        "url": "https://github.com/Ice-Hazymoon/jevwright/issues"
    },
    "keywords": [
        "e2e",
        "end-to-end",
        "testing",
        "browser",
        "playwright",
        "natural-language",
        "ai",
        "llm",
        "typesafe",
        "jev"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.mts",
    "bin": {
        "jevwright": "./dist/bin.mjs"
    },
    "files": [
        "CHANGELOG.md",
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "calibrate": "jiti scripts/calibrate.ts",
        "prepublishOnly": "npm run typecheck && npm run build && npm test"
    },
    "peerDependencies": {
        "playwright": ">=1.63.0 <2"
    },
    "dependencies": {
        "@openrouter/ai-sdk-provider": "~3.1.0",
        "ai": "7.0.107",
        "fflate": "0.8.3",
        "jiti": "^2.7.0",
        "proxy-chain": "^3.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "playwright": "1.63.0",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
